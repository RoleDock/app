# Local development defaults only. Do not reuse these values in production.
POSTGRES_DB=roledock
POSTGRES_USER=roledock
POSTGRES_PASSWORD=roledock
POSTGRES_PORT=5432

# Optional Spring Boot overrides when the backend does not use the defaults above.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roledock
SPRING_DATASOURCE_USERNAME=roledock
SPRING_DATASOURCE_PASSWORD=roledock
